{
  "name": "podcast-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-speaker podcast generator powered by ElevenLabs Text-to-Dialogue (eleven_v3)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @podcast/api",
    "dev:web": "npm run dev -w @podcast/web",
    "test": "npm run test -w @podcast/core && npm run test -w @podcast/api",
    "test:watch": "npm run test:watch -w @podcast/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "supabase": "^3.1.0",
    "typescript": "^5.6.3"
  }
}
