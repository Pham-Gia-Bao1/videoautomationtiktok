# Local API and web origins
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local persistent development storage (gitignored)
DATA_DIR=./apps/api/data
AUDIO_DIR=./apps/api/data/audio

# Optional ElevenLabs integration; keep the key server-side
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TIMEOUT_MS=120000
ELEVENLABS_VIDEO_TIMEOUT_MS=1200000
ELEVENLABS_STT_MODEL_ID=scribe_v3

# Optional Ghost Editor integration (Windows: Claude Code + Git Bash + FFmpeg)
# Sign in once with `claude auth login`; the API calls Claude Code in print mode.
# CLAUDE_CODE_PATH=claude
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
# GHOST_EDITOR_CLAUDE_MODEL=sonnet
# GHOST_EDITOR_TIMEOUT_MS=180000

# Optional local executable overrides; defaults are ffmpeg and ffprobe on PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_MS=300000
FFMPEG_VIDEO_TIMEOUT_MS=1800000

# Required in production. Supabase HS256 JWT signing secret, not the service key.
# SUPABASE_JWT_SECRET=

# Supabase persistence
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
